# Copy to deploy/.env, replace every value, and keep that file out of Git.
CLICKHOUSE_PASSWORD=replace-with-a-long-random-secret
DRYRUN_DB_PASSWORD=replace-with-a-long-random-secret
MINIO_ROOT_USER=dryrun-admin
MINIO_ROOT_PASSWORD=replace-with-at-least-16-random-characters
KEYCLOAK_DB_PASSWORD=replace-with-a-long-random-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-secret
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-secret
DRYRUN_OIDC_COOKIE_SECRET=replace-with-at-least-32-random-characters
DRYRUN_METRICS_TOKEN=replace-with-at-least-32-random-characters
DRYRUN_STATE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
DRYRUN_WORKSPACE_ALIAS=default
# Use an absolute host path. Its only line must equal DRYRUN_METRICS_TOKEN.
DRYRUN_METRICS_TOKEN_FILE=/absolute/path/to/dry-run/deploy/secrets/dryrun_metrics_token
DRYRUN_WORKSPACE_NAME=AI Quality
