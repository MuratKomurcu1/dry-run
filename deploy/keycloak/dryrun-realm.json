{
  "realm": "dryrun",
  "enabled": true,
  "displayName": "Dry Run",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "groups": [
    { "name": "dryrun-admins" },
    { "name": "dryrun-editors" },
    { "name": "dryrun-viewers" }
  ],
  "clients": [
    {
      "clientId": "dryrun",
      "name": "Dry Run Team",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://quality.localhost:8080/api/v1/auth/oidc/callback"],
      "webOrigins": ["http://quality.localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ]
}
